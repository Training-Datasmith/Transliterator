{
  "name": "behat/transliterator",
  "abandoned": true,
  "description": "String transliterator",
  "keywords": [
    "transliterator",
    "slug",
    "i18n"
  ],
  "type": "library",
  "license": "Artistic-1.0",
  "repositories": [
    {
      "type": "composer",
      "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
      "canonical": false
    }
  ],
  "require": {
    "php": ">=7.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.5.25 || ^9.5.19",
    "php-yaoi/php-yaoi": "^1.0",
    "chuyskywalker/rolling-curl": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Behat\\Transliterator\\": "src/Behat/Transliterator"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Behat\\Tests\\Transliterator\\": "tests"
    }
  },
  "scripts": {
    "check-cluster-pins": "php scripts/check-cluster-pins.php",
    "test": [
      "@check-cluster-pins",
      "phpunit --colors=never --no-coverage"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.x-dev"
    }
  }
}
